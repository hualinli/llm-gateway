# 全新库 0 -> 4：在同一个 disposable Postgres 实例里新建 gateway_test_fresh
$ docker compose -f docker-compose.test.yml exec -T postgres psql -U gateway_test -d gateway_test -c 'CREATE DATABASE gateway_test_fresh'
CREATE DATABASE
$ POSTGRES_DSN='postgres://gateway_test:test_only_local@127.0.0.1:15433/gateway_test_fresh?sslmode=disable' go run ./cmd/migrate version   # 迁移前：应为 none
version=none dirty=false
$ POSTGRES_DSN='postgres://gateway_test:test_only_local@127.0.0.1:15433/gateway_test_fresh?sslmode=disable' go run ./cmd/migrate up
$ POSTGRES_DSN='postgres://gateway_test:test_only_local@127.0.0.1:15433/gateway_test_fresh?sslmode=disable' go run ./cmd/migrate version
version=4 dirty=false
$ POSTGRES_DSN='postgres://gateway_test:test_only_local@127.0.0.1:15433/gateway_test_fresh?sslmode=disable' go run ./cmd/migrate up   # 再跑一次：ErrNoChange 视为成功
# 迁移不写入任何用户/组织/成员行（ADR-0002 §3：不伪造历史归属）
 users | orgs | memberships | sessions 
-------+------+-------------+----------
     0 |    0 |           0 |        0
(1 row)

$ docker compose -f docker-compose.test.yml exec -T postgres psql -U gateway_test -d gateway_test -c 'DROP DATABASE gateway_test_fresh'
DROP DATABASE
