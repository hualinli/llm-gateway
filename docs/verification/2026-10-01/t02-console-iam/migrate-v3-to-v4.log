# cmd/migrate flags: usage: migrate up|down-one|version (POSTGRES_DSN required)
$ POSTGRES_DSN='postgres://gateway_test:test_only_local@127.0.0.1:15433/gateway_test?sslmode=disable' go run ./cmd/migrate version
version=4 dirty=false

# v3 -> v4：先 down-one 回到 3，再 up 回到 4
$ POSTGRES_DSN='postgres://gateway_test:test_only_local@127.0.0.1:15433/gateway_test?sslmode=disable' go run ./cmd/migrate down-one
$ POSTGRES_DSN='postgres://gateway_test:test_only_local@127.0.0.1:15433/gateway_test?sslmode=disable' go run ./cmd/migrate version
version=3 dirty=false
$ POSTGRES_DSN='postgres://gateway_test:test_only_local@127.0.0.1:15433/gateway_test?sslmode=disable' go run ./cmd/migrate up
$ POSTGRES_DSN='postgres://gateway_test:test_only_local@127.0.0.1:15433/gateway_test?sslmode=disable' go run ./cmd/migrate version
version=4 dirty=false
