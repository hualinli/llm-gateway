      ],
      "environment": {
        "GATEWAY_PROFILE": "demo",
        "METERING_REQUIRE_POSTGRES": "true",
        "POSTGRES_DSN": "<redacted>",
        "REDIS_ADDR": "redis:6379"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-qO-",
          "http://localhost:8091/readyz"
