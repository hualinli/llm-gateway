        "CONSOLE_SECURE_COOKIES": "false",
        "CONTROL_ADDR": "control:50051",
        "CONTROL_CONSOLE_SERVICE_NAME": "console",
        "GATEWAY_PROFILE": "demo",
        "POSTGRES_DSN": "<redacted>"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-qO-",
          "http://localhost:8092/readyz"
        ],
        "timeout": "1s",
        "interval": "2s",
        "retries": 30
      },
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8092,
          "published": "18092",
          "protocol": "tcp"
        }
      ]
    },
    "control": {
      "build": {
        "context": "/Users/lihualin/Projects/llm-gateway/.worktrees/t12",
