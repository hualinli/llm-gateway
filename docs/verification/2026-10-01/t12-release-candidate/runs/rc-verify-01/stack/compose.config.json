        "redis": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": [
        "/usr/local/bin/gateway"
      ],
      "environment": {
        "CONTROL_ADDR": "control:50051",
        "GATEWAY_ACCESS_GUARD": "pg",
        "GATEWAY_BILLING": "pg",
        "GATEWAY_MAX_ACTIVE_STREAMS": "256",
        "GATEWAY_PROFILE": "demo",
        "LIMITER_ON_REDIS_ERROR": "closed",
