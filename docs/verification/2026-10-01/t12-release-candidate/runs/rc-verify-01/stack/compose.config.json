      "volumes": [
        {
          "type": "volume",
          "source": "metering-spool",
          "target": "/var/lib/llm-gateway/metering-spool",
          "volume": {}
        }
      ]
    },
    "migrate": {
      "build": {
        "context": "/Users/lihualin/Projects/llm-gateway/.worktrees/t12",
        "dockerfile": "/Users/lihualin/Projects/llm-gateway/.worktrees/t12/data/release-candidate/rc-verify-01/Dockerfile.rc",
        "args": {
          "GOPROXY": "https://goproxy.cn,direct"
        }
      },
      "command": [
        "up"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": [
        "/usr/local/bin/migrate"
      ],
      "environment": {
        "POSTGRES_DSN": "<redacted>"
      },
      "networks": {
        "default": null
      },
      "restart": "no"
    },
    "postgres": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "llm_gateway",
        "POSTGRES_PASSWORD": "<redacted>",
        "POSTGRES_USER": "gateway"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U gateway -d llm_gateway"
        ],
        "timeout": "1s",
        "interval": "2s",
        "retries": 10
      },
      "image": "postgres:18.6",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 5432,
          "published": "25433",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "pg-data",
          "target": "/var/lib/postgresql",
          "volume": {}
        }
      ]
    },
    "redis": {
      "command": [
        "redis-server",
        "--appendonly",
        "yes",
        "--appendfsync",
        "everysec"
      ],
      "entrypoint": null,
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "timeout": "1s",
        "interval": "2s",
        "retries": 10
