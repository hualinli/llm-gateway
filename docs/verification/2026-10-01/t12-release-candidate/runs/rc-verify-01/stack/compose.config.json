      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 50051,
          "published": "15051",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 50052,
          "published": "15052",
          "protocol": "tcp"
        }
      ],
      "user": "1000:1000",
      "volumes": [
        {
          "type": "bind",
          "source": "/Users/lihualin/Projects/llm-gateway/.worktrees/t12/data/release-candidate/rc-verify-01/secrets/provider-credential-master-key",
          "target": "/run/secrets/provider-credential-master-key",
          "read_only": true,
          "bind": {
