      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 6379,
          "published": "26379",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "redis-data",
          "target": "/data",
          "volume": {}
        }
      ],
      "environment": {}
