{
  "name": "llm-gateway-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LLM Gateway Console web app (T04 minimal loop + T08 three-perspective UI)",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.104.0",
    "antd": "6.6.5",
    "dayjs": "1.11.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
